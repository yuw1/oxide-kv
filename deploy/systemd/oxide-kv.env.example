# Per-instance environment file for oxide-kv@%i.service.
#
# Path: /etc/oxide-kv/%i.env (where %i is node-1 / node-2 / node-3)
# Permissions: 0640 root:oxide-kv (the unit reads it as user oxide-kv).
#
# Each variable is a single line. Do not quote values; systemd parses
# them raw. Use distinct ports per node (increment by 1, or pick any
# non-overlapping set).

# Raft inter-node listen address. Used as --addr on the binary.
# Should be reachable from the other two nodes on the cluster's
# internal network. Format: <host-or-ip>:<port>
OXIDE_KV_ADDR=10.0.0.1:9001

# Client API listen address. Used as --client-addr. Reachable from
# application hosts that talk to the cluster.
OXIDE_KV_CLIENT_ADDR=10.0.0.1:9101

# Comma-separated list of OTHER nodes' OXIDE_KV_ADDR values
# (excluding this node). Do NOT include the trailing whitespace.
# Example for a 3-node cluster where this is node-1:
#   OXIDE_KV_PEERS=10.0.0.2:9001,10.0.0.3:9001
OXIDE_KV_PEERS=10.0.0.2:9001,10.0.0.3:9001

# Per-instance data directory. Must be writable by the oxide-kv user.
# Sub-directories (wal/, snapshots/) are created by the binary on
# first start. Each node gets its own data dir; do NOT share.
OXIDE_KV_DATA_DIR=/var/lib/oxide-kv/node-1

# Optional: WAL auto-compaction threshold in bytes. Default 64 MiB.
# Lower it for tighter disk usage, raise it for less snapshot churn.
# OXIDE_SNAPSHOT_THRESHOLD_BYTES=67108864